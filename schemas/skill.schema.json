{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontmatter de las skills del Hub",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 1024
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "compatibility": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 500
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "allowed-tools": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "name",
    "description"
  ],
  "additionalProperties": false
}
